def trova_pos(a,v):
    b=[]
    i=0
    #n=len(a)
#input a una lista, v un valore
#restituisce una lista di interi contenente le posizioni di v in a
    while i<len(a): #O(1) perchè in realtà legge solo una volta la lunghezzza della stringa
        if a[i]==v: #O(1)
            b.append(i)
        i+=1
    return b

#complessità temporale: O(n) nel caso peggiore

a=[1,2,3,4,5,6,9,7]
print(trova_pos(a, 6))

